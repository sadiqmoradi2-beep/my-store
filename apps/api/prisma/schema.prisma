generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlanCode {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  /// Card payment — own Income bucket, separate from Zelle.
  CARD
  EBT
  ZELLE
  /// Immediate income, own Income bucket — like Cash/EBT/Zelle, just a card swipe.
  DEBIT_CARD
}

enum IncomePart {
  CASH
  CARD
  EBT
  ZELLE
  DEBIT_CARD
}

enum SessionRole {
  SELLER
  EMPLOYEE
  PARTNER
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

enum HarvestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DebtKind {
  LOAN
  DEFICIT
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

enum PriceType {
  PURCHASE
  SALE
  WHOLESALE
  PROMO
}

enum Currency {
  USDT
}

enum CashTransactionType {
  SALE
  INCOME
  EXPENSE
  REFUND
  WITHDRAWAL
  TRANSFER_IN // internal transfer, destination leg (+)
  TRANSFER_OUT // internal transfer, source leg (−)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
}

enum CalendarType {
  GREGORIAN
}

// ──────────────────── Platform / Tenancy ─────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  address   String?
  logoUrl   String?
  isActive  Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  subscription  Subscription?
  tenantModules TenantModule[]
  roles         Role[]
  categories    Category[]
  products      Product[]
  sales         Sale[]
  cashRegisters CashRegister[]
  subscriptionHistory SubscriptionHistory[]
  platformFeedback    PlatformFeedback[]
  partners            Partner[]
  licenseKeysUsed     LicenseKey[]
  cashTransactionEdits      CashTransactionEdit[]
  cashTransactionEditGrants CashTransactionEditGrant[]
  cashLedgerEvents          CashLedgerEvent[]
  cashTransfers             CashTransfer[]
}

model Plan {
  id               String         @id @default(cuid())
  code             PlanCode       @unique
  name             String
  priceMonthly     Decimal        @db.Decimal(10, 2)
  priceYearly      Decimal?       @db.Decimal(10, 2)
  requiresApproval Boolean        @default(false)
  limits           Json
  isActive         Boolean        @default(true)
  subscriptions    Subscription[] @relation("SubscriptionPlan")
  pendingFor       Subscription[] @relation("SubscriptionPendingPlan")
  licenseKeys      LicenseKey[]
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  startsAt           DateTime           @default(now())
  endsAt             DateTime?
  trialEndsAt        DateTime?
  pendingPlanId      String? // pending plan upgrade/change request awaiting platform admin approval
  pendingRequestedAt DateTime?
  billingCycle         BillingCycle? // null while on the free plan
  pendingBillingCycle  BillingCycle? // the cycle requested via the cash/approval-required path
  lastExpiryReminderAt DateTime? // expiry reminder dedup — same pattern as Debt.lastReminderAt
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan   @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan Plan?  @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
}

model Module {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  version     String
  description String?
  isCore      Boolean   @default(false)
  dependsOn   String[]  @default([])
  minPlan     PlanCode?

  tenantModules TenantModule[]
}

model TenantModule {
  id       String  @id @default(cuid())
  tenantId String
  moduleId String
  enabled  Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@index([tenantId])
}

// ───────────────────────── RBAC ──────────────────────────────

model Role {
  id       String  @id @default(cuid())
  tenantId String? // null = system role
  key      String
  name     String
  isSystem Boolean @default(false)

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  users           User[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  moduleKey   String
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id               String       @id @default(cuid())
  tenantId         String? // null = platform Super Admin
  email            String       @unique
  passwordHash     String
  fullName         String
  phone            String?
  roleId           String
  branchId         String?
  status           UserStatus   @default(ACTIVE)
  locale           String       @default("en")
  calendar         CalendarType @default(GREGORIAN)
  theme            String       @default("system")
  uiPrefs          Json?
  totpSecret       String?
  totpEnabledAt    DateTime?
  refreshTokenHash String?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  priceChanges               PriceHistory[]
  stockMovements             StockMovement[]
  cashTransactions           CashTransaction[]
  salesCreated               Sale[]                 @relation("SaleCreatedBy")
  workSessionsCreated        WorkSession[]          @relation("WorkSessionCreatedBy")
  workSessionsClosed         WorkSession[]          @relation("WorkSessionClosedBy")
  harvestsRequested          CashHarvest[]          @relation("HarvestRequestedBy")
  harvestsCollected          CashHarvest[]          @relation("HarvestCollectedBy")
  sessionAdjustmentsMade     SessionAdjustment[]    @relation("SessionAdjustmentBy")
  sessionAuditsMade          WorkSessionAudit[]     @relation("SessionAuditBy")
  sellerProfile              SellerProfile?
  salaryPaymentsMade         SalaryPayment[]        @relation("SalaryPaymentPerformedBy")
  sellerSalaryPaymentsMade   SellerSalaryPayment[]  @relation("SellerSalaryPaymentPerformedBy")
  employeeShiftsStarted      EmployeeShift[]        @relation("EmployeeShiftStartedBy")
  employeeShiftsEnded        EmployeeShift[]        @relation("EmployeeShiftEndedBy")
  employeeAttendanceRecorded EmployeeAttendance[]   @relation("EmployeeAttendanceRecordedBy")
  purchasesCreated           Purchase[]             @relation("PurchaseCreatedBy")
  debtsCreated               Debt[]                 @relation("DebtCreatedBy")
  debtPaymentsMade           DebtPayment[]          @relation("DebtPaymentPerformedBy")
  notifications              Notification[]
  platformFeedback           PlatformFeedback[]
  partnerLedgerEntriesMade   PartnerLedgerEntry[]   @relation("PartnerLedgerEntryPerformedBy")
  licenseKeysCreated         LicenseKey[]           @relation("LicenseKeyCreatedBy")
  purchaseReturnsCreated     PurchaseReturn[]       @relation("PurchaseReturnCreatedBy")
  cashTransfersMade          CashTransfer[]         @relation("CashTransferPerformedBy")
  teamPerson                 TeamPerson?            @relation("TeamPersonUser")

  @@index([tenantId])
}

// ─────────────────── Organization ────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses    Warehouse[]
  users         User[]
  carts         Cart[]
  sales         Sale[]
  cashRegisters CashRegister[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  phone     String?
  ownerName String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stocks          Stock[]
  stockMovements  StockMovement[]
  purchaseReturns PurchaseReturn[]

  @@index([tenantId])
  @@index([branchId])
}

// ─────────────────────── Catalog ─────────────────────────────

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  parentId  String?
  name      String
  slug      String
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model Product {
  id              String    @id @default(cuid())
  tenantId        String
  categoryId      String
  name            String
  slug            String
  sku             String
  barcode         String?
  description     String?
  unit            String    @default("Piece")
  purchasePrice   Decimal   @db.Decimal(18, 2)
  salePrice       Decimal   @db.Decimal(18, 2)
  wholesalePrice  Decimal?  @db.Decimal(18, 2)
  promoPrice      Decimal?  @db.Decimal(18, 2)
  promoStartsAt   DateTime?
  promoEndsAt     DateTime?
  currency        Currency  @default(USDT)
  exchangeRate    Decimal?  @db.Decimal(18, 4)
  minStockLevel   Int       @default(0)
  expiryDate        DateTime? // when this batch/product expires — triggers a "close to expiry" alert
  lastExpiryAlertAt DateTime? // last time an expiry alert was sent — avoids re-notifying every sweep
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  priceHistory   PriceHistory[]
  stocks         Stock[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  saleItems      SaleItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id          String    @id @default(cuid())
  tenantId    String
  productId   String
  priceType   PriceType
  oldPrice    Decimal?  @db.Decimal(18, 2)
  newPrice    Decimal   @db.Decimal(18, 2)
  currency    Currency  @default(USDT)
  changedById String
  note        String?
  createdAt   DateTime  @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([productId, createdAt])
  @@index([tenantId])
}

// ─────────────────────── Inventory ───────────────────────────

model Stock {
  id          String @id @default(cuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([tenantId])
  @@index([warehouseId])
}

model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  productId     String
  warehouseId   String
  type          StockMovementType
  quantity      Int // always positive; direction comes from type
  reason          String?
  referenceType   String?
  referenceId     String?
  transferId      String?
  receiptImageUrl String? // receipt image — for a warehouse request (transfer)
  performedById String
  createdAt     DateTime          @default(now())

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  performedBy User      @relation(fields: [performedById], references: [id])

  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@index([transferId])
}

// ───────────────────────── Sales ─────────────────────────────

model Cart {
  id             String   @id @default(cuid())
  tenantId       String
  branchId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch   Branch     @relation(fields: [branchId], references: [id])
  items    CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(18, 4)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

// ──────────────── Sales (POS) ────────────────

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  branchId      String
  saleNumber    Int
  total         Decimal       @db.Decimal(18, 2)
  cost          Decimal       @default(0) @db.Decimal(18, 2) // purchase-price snapshot of all items — profit = total - cost
  paymentMethod PaymentMethod
  registerId    String? // the Income register that received the money
  sessionId     String? // the work session (cash box) this sale belongs to
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch        @relation(fields: [branchId], references: [id])
  createdBy User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  session   WorkSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, paymentMethod, createdAt])
  @@index([sessionId])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String // snapshot
  quantity    Int
  unitPrice   Decimal @db.Decimal(18, 4)
  unitCost    Decimal @db.Decimal(18, 2) // purchase-price snapshot
  total       Decimal @db.Decimal(18, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// ──────────────── Income (cash parts) ────────────────

model CashRegister {
  id                   String   @id @default(cuid())
  tenantId             String
  branchId             String
  name                 String
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  part                 IncomePart @default(CASH)
  openingBalance       Decimal  @default(0) @db.Decimal(18, 2)
  balance              Decimal  @default(0) @db.Decimal(18, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transactions CashTransaction[]
  transfersOut CashTransfer[] @relation("CashTransferFrom")
  transfersIn  CashTransfer[] @relation("CashTransferTo")

  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, part])
}

model CashTransaction {
  id            String              @id @default(cuid())
  tenantId      String
  registerId    String
  type          CashTransactionType
  amount        Decimal             @db.Decimal(18, 2) // always positive; direction comes from type
  balanceAfter  Decimal             @db.Decimal(18, 2)
  category      String?
  note          String?
  receiptUrl    String? // optional pay slip / receipt photo (INCOME and WITHDRAWAL entries)
  referenceType String?
  referenceId   String?
  sessionId     String? // the work session whose cash box paid / received this
  performedById String
  createdAt     DateTime            @default(now()) // the business date (back-dating and date corrections change it)
  // The actual moment the row was recorded (UTC). Immutable (DB trigger); NULL = unknown (rows older than Stage D).
  recordedAt    DateTime?           @default(now())
  version       Int                 @default(0) // bumped by every correction — optimistic concurrency
  // Correction entry: a signed amount of the same type added to an original manual transaction
  correctionOfId   String?
  correctionEditId String? // the CashTransactionEdit audit row that created it (kept outside backups)
  // Paid By / Who Is Paid — at most one person per side (DB check); kind + name are snapshots kept for history
  paidByEmployeeId     String?
  paidByPartnerId      String?
  paidByPersonId       String?
  paidByKind           String? // EMPLOYEE | PARTNER | PERSON
  paidByName           String?
  receivedByEmployeeId String?
  receivedByPartnerId  String?
  receivedByPersonId   String?
  receivedByKind       String?
  receivedByName       String?
  // Transfer: the Financial Personnel member who sent / moved the money (attribution only, never moves money)
  transferredByPersonId String?
  transferredByName     String?
  // Staff actor is separate from external payer/recipient; performedById remains the authenticated operator.
  staffActorPersonId    String?
  staffActorName        String?
  destination           String?
  staffActorPerson      TeamPerson? @relation("CashTxStaffActor", fields: [staffActorPersonId], references: [id], onDelete: SetNull)

  register    CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  performedBy User         @relation(fields: [performedById], references: [id])
  session     WorkSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  paidByEmployee     Employee?   @relation("CashTxPaidByEmployee", fields: [paidByEmployeeId], references: [id], onDelete: SetNull)
  paidByPartner      Partner?    @relation("CashTxPaidByPartner", fields: [paidByPartnerId], references: [id], onDelete: SetNull)
  paidByPerson       TeamPerson? @relation("CashTxPaidByPerson", fields: [paidByPersonId], references: [id], onDelete: SetNull)
  receivedByEmployee Employee?   @relation("CashTxReceivedByEmployee", fields: [receivedByEmployeeId], references: [id], onDelete: SetNull)
  receivedByPartner  Partner?    @relation("CashTxReceivedByPartner", fields: [receivedByPartnerId], references: [id], onDelete: SetNull)
  receivedByPerson   TeamPerson? @relation("CashTxReceivedByPerson", fields: [receivedByPersonId], references: [id], onDelete: SetNull)
  transferredByPerson TeamPerson? @relation("CashTxTransferredByPerson", fields: [transferredByPersonId], references: [id], onDelete: SetNull)
  correctionOf       CashTransaction?  @relation("CashTxCorrections", fields: [correctionOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  corrections        CashTransaction[] @relation("CashTxCorrections")

  @@index([tenantId, createdAt])
  @@index([correctionOfId])
  @@index([registerId, recordedAt])
  @@index([registerId, createdAt])
  @@index([sessionId])
  @@index([paidByEmployeeId])
  @@index([paidByPartnerId])
  @@index([paidByPersonId])
  @@index([receivedByEmployeeId])
  @@index([receivedByPartnerId])
  @@index([receivedByPersonId])
  @@index([transferredByPersonId])
  @@index([staffActorPersonId])
}

/// A registered person who is neither an employee nor a partner (Team → People). No payroll, no login.
/// Append-only history of corrections to manual Income / Expense / Withdrawal transactions.
/// Snapshots only (no links to transactions, accounts or users) so it survives resets and restores.
model CashTransactionEdit {
  id              String   @id @default(cuid())
  tenantId        String
  requestId       String // client idempotency key
  transactionId   String // the original transaction (snapshot id; may no longer exist after a reset)
  transactionType String
  branchId        String?
  editorUserId    String
  editorName      String
  mode            String // WINDOW | EXCEPTION
  grantId         String?
  method          String // DIRECT (in place, latest entry) | ENTRIES (correction entries) | NONE (date / description only)
  reason          String
  amountBefore    Decimal  @db.Decimal(18, 2)
  amountAfter     Decimal  @db.Decimal(18, 2)
  dateBefore      DateTime
  dateAfter       DateTime
  registerBeforeId   String
  registerBeforeName String
  registerAfterId    String
  registerAfterName  String
  noteBefore      String?
  noteAfter       String?
  balanceChanges  Json // [{ registerId, registerName, before, after }]
  entryIds        String[] // correction entries created by this edit
  recordedAtOfOriginal DateTime?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requestId])
  @@index([tenantId, transactionId])
  @@index([tenantId, createdAt])
}

/// A Store Admin's single-use, short-lived exception to correct one transaction (after re-entering the password)
model CashTransactionEditGrant {
  id            String    @id @default(cuid())
  tenantId      String
  transactionId String
  userId        String
  userName      String
  reason        String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, transactionId])
}

/// Ledger-wide events that change which corrections are represented in the ledger (backup restore, data reset)
model CashLedgerEvent {
  id              String    @id @default(cuid())
  tenantId        String
  kind            String // RESTORE | RESET
  scope           String? // reset scope
  backupId        String?
  backupCreatedAt DateTime? // a restore brings back the ledger as it was at this moment
  userId          String?
  userName        String?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// An internal transfer between two accounts of the same store. Its two ledger legs are CashTransaction rows
/// (TRANSFER_OUT on the source, TRANSFER_IN on the destination) with referenceType 'transfer' + referenceId = id.
model CashTransfer {
  id                    String   @id @default(cuid())
  tenantId              String
  requestId             String // client idempotency key
  fromRegisterId        String
  toRegisterId          String
  amount                Decimal  @db.Decimal(18, 2)
  transferredByPersonId String?
  transferredByName     String
  note                  String?
  performedById         String
  createdAt             DateTime @default(now()) // business date
  recordedAt            DateTime @default(now())
  /// Set on a reversal: the transfer it undoes (each transfer can be reversed once)
  reversalOfId          String?  @unique
  reversalReason        String?

  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromRegister        CashRegister @relation("CashTransferFrom", fields: [fromRegisterId], references: [id], onDelete: Cascade)
  toRegister          CashRegister @relation("CashTransferTo", fields: [toRegisterId], references: [id], onDelete: Cascade)
  transferredByPerson TeamPerson?  @relation("CashTransferBy", fields: [transferredByPersonId], references: [id], onDelete: SetNull)
  performedBy         User         @relation("CashTransferPerformedBy", fields: [performedById], references: [id])

  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
}

model TeamPerson {
  id          String   @id @default(cuid())
  tenantId    String
  displayName String
  notes       String?
  isActive    Boolean  @default(true)
  /// Deleted while still referenced by financial history: hidden from new selections, name kept for history
  archivedAt  DateTime?
  /// Optional login account (created by the Store Admin through the invite flow; hidden per-person role)
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                 User?             @relation("TeamPersonUser", fields: [userId], references: [id], onDelete: SetNull)
  paidTransactions     CashTransaction[] @relation("CashTxPaidByPerson")
  receivedTransactions CashTransaction[] @relation("CashTxReceivedByPerson")
  transferredTransactions CashTransaction[] @relation("CashTxTransferredByPerson")
  cashTransfers           CashTransfer[]    @relation("CashTransferBy")
  actorTransactions       CashTransaction[] @relation("CashTxStaffActor")

  @@index([tenantId, isActive])
}

// ─────────────── Phase 3 — HR / Debts / Returns / Suppliers ───────────────

enum DebtDirection {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  OPEN
  PARTIAL
  SETTLED
}

enum SellerPayType {
  COMMISSION
  FIXED_SALARY
  HOURLY
}

model SellerProfile {
  id                String        @id @default(cuid())
  tenantId          String
  userId            String        @unique
  payType           SellerPayType @default(COMMISSION)
  commissionPercent Decimal       @default(0) @db.Decimal(5, 2)
  fixedSalaryAmount Decimal?      @db.Decimal(18, 2)
  isActive          Boolean       @default(true)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions    CommissionEntry[]
  salaryPayments SellerSalaryPayment[]
  workSessions   WorkSession[]

  @@index([tenantId])
}

model SellerSalaryPayment {
  id              String   @id @default(cuid())
  tenantId        String
  sellerProfileId String
  amount          Decimal  @db.Decimal(18, 2)
  period          String // e.g. "1405-04"
  registerId      String?
  note            String?
  receiptImageUrl String? // optional pay slip / receipt image or PDF
  performedById   String
  createdAt       DateTime @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  performedBy   User          @relation("SellerSalaryPaymentPerformedBy", fields: [performedById], references: [id])

  @@index([tenantId, createdAt])
  @@index([sellerProfileId])
}

model CommissionEntry {
  id              String   @id @default(cuid())
  tenantId        String
  sellerProfileId String
  saleId          String
  saleNumber      Int
  amount          Decimal  @db.Decimal(18, 2)
  percent         Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())

  sellerProfile SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, saleId])
  @@index([tenantId, createdAt])
}

model Employee {
  id        String        @id @default(cuid())
  tenantId  String
  userId    String?
  fullName  String
  position  String
  phone     String?
  payType   SellerPayType @default(FIXED_SALARY)
  salary    Decimal       @db.Decimal(18, 2)
  hourlyRate Decimal?     @db.Decimal(18, 2) // pay per approved hour, HOURLY only (USDT)
  hiredAt   DateTime      @default(now())
  isActive  Boolean       @default(true)
  notes     String?
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  salaryPayments SalaryPayment[]
  workSessions   WorkSession[]
  shifts         EmployeeShift[]
  attendance     EmployeeAttendance[]
  workIntervals  EmployeeWorkInterval[]
  cashPaid       CashTransaction[] @relation("CashTxPaidByEmployee")
  cashReceived   CashTransaction[] @relation("CashTxReceivedByEmployee")

  @@index([tenantId])
}

/**
 * Daily employee attendance — one row per employee/day (upsert)
 */
model EmployeeAttendance {
  id           String           @id @default(cuid())
  tenantId     String
  employeeId   String
  date         DateTime         @db.Date
  status       AttendanceStatus
  checkIn      DateTime?
  checkOut     DateTime?
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("EmployeeAttendanceRecordedBy", fields: [recordedById], references: [id])
  workInterval EmployeeWorkInterval?

  @@unique([employeeId, date])
  @@index([tenantId, employeeId])
}

/**
 * Work session: when the shift started and with what opening cash balance
 */
model EmployeeShift {
  id          String    @id @default(cuid())
  tenantId    String
  employeeId  String
  registerId  String?
  openingCash Decimal   @db.Decimal(18, 2)
  closingCash Decimal?  @db.Decimal(18, 2)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  startedById String
  endedById   String?

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startedBy User     @relation("EmployeeShiftStartedBy", fields: [startedById], references: [id])
  endedBy   User?    @relation("EmployeeShiftEndedBy", fields: [endedById], references: [id])

  @@index([tenantId, employeeId])
}

enum SalaryPaymentStatus {
  PENDING
  PAID
}

model SalaryPayment {
  id            String              @id @default(cuid())
  tenantId      String
  employeeId    String
  amount        Decimal             @db.Decimal(18, 2) // base salary amount for this payment
  bonus         Decimal             @default(0) @db.Decimal(18, 2)
  deduction     Decimal             @default(0) @db.Decimal(18, 2)
  status        SalaryPaymentStatus @default(PAID)
  period        String // e.g. "1405-04"
  registerId    String?
  note          String?
  receiptImageUrl String? // optional pay slip / receipt image or PDF
  performedById String
  createdAt     DateTime            @default(now())
  paidAt        DateTime? // set when a PENDING payment is marked PAID

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  performedBy User     @relation("SalaryPaymentPerformedBy", fields: [performedById], references: [id])
  workIntervals EmployeeWorkInterval[]

  @@index([tenantId, createdAt])
  @@index([employeeId])
}

enum WorkIntervalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

/// One payable stretch of work for an HOURLY employee, taken from exactly ONE source: an attendance
/// day or a work session (DB check: exactly one of attendanceId / workSessionId). Each source can feed
/// payroll only once (unique). Minutes are whole numbers; money is computed from approvedMinutes × the
/// rate snapshotted when the stretch was approved.
model EmployeeWorkInterval {
  id              String             @id @default(cuid())
  tenantId        String
  employeeId      String
  attendanceId    String?            @unique
  workSessionId   String?            @unique
  startAt         DateTime
  endAt           DateTime? // null = source has no trustworthy end — needs review, never estimated
  recordedMinutes Int? // from the source; null when endAt is missing or before startAt
  approvedMinutes Int?
  hourlyRate      Decimal?           @db.Decimal(18, 2) // snapshot at approval
  status          WorkIntervalStatus @default(PENDING)
  correctionReason String?
  approvedById    String?
  approvedAt      DateTime?
  salaryPaymentId String?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance    EmployeeAttendance? @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  workSession   WorkSession?        @relation(fields: [workSessionId], references: [id], onDelete: Restrict)
  salaryPayment SalaryPayment?      @relation(fields: [salaryPaymentId], references: [id], onDelete: Restrict)
  events        EmployeeWorkIntervalEvent[]

  @@index([tenantId, employeeId, status])
  @@index([employeeId, startAt])
  @@index([salaryPaymentId])
}

/// Append-only history of every review step on a work interval (who, what, why)
model EmployeeWorkIntervalEvent {
  id          String   @id @default(cuid())
  tenantId    String
  intervalId  String
  action      String // APPROVED | CORRECTED | REJECTED | PAID
  fromMinutes Int?
  toMinutes   Int?
  reason      String?
  userId      String
  userName    String // snapshot
  createdAt   DateTime @default(now())

  interval EmployeeWorkInterval @relation(fields: [intervalId], references: [id], onDelete: Cascade)

  @@index([intervalId, createdAt])
}

// ──────────────── Work sessions (cash box of a seller / employee / partner) ────────────────

model WorkSession {
  id                  String        @id @default(cuid())
  tenantId            String
  code                String // SES-2026-0001
  role                SessionRole
  sellerProfileId     String?
  employeeId          String?
  partnerId           String?
  personName          String // snapshot
  status              SessionStatus @default(ACTIVE)
  startedAt           DateTime
  openingCash         Decimal       @default(0) @db.Decimal(18, 2) // immutable after start — corrected only through an audited adjustment
  harvestLimit        Decimal       @default(0) @db.Decimal(18, 2)
  openingNotes        String?
  closedAt            DateTime?
  actualClosingCash   Decimal?      @db.Decimal(18, 2)
  expectedClosingCash Decimal?      @db.Decimal(18, 2) // snapshot at closing
  closingNotes        String?
  createdById         String
  closedById          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  seller       SellerProfile?      @relation(fields: [sellerProfileId], references: [id])
  employee     Employee?           @relation(fields: [employeeId], references: [id])
  partner      Partner?            @relation(fields: [partnerId], references: [id])
  createdBy    User                @relation("WorkSessionCreatedBy", fields: [createdById], references: [id])
  closedBy     User?               @relation("WorkSessionClosedBy", fields: [closedById], references: [id])
  harvests     CashHarvest[]
  adjustments  SessionAdjustment[]
  audits       WorkSessionAudit[]
  transactions CashTransaction[]
  sales        Sale[]
  workInterval EmployeeWorkInterval?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
}

/// Cash collected from a session's cash box. The session total is always the SUM of these rows.
model CashHarvest {
  id            String        @id @default(cuid())
  tenantId      String
  number        Int // HRV-0001
  sessionId     String
  amount        Decimal       @db.Decimal(18, 2)
  method        IncomePart    @default(CASH)
  status        HarvestStatus @default(APPROVED)
  note          String?
  harvestedAt   DateTime      @default(now())
  requestedById String
  collectedById String? // who collected / approved it
  decidedAt     DateTime?
  createdAt     DateTime      @default(now())

  session     WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("HarvestRequestedBy", fields: [requestedById], references: [id])
  collectedBy User?       @relation("HarvestCollectedBy", fields: [collectedById], references: [id])

  @@unique([tenantId, number])
  @@index([sessionId, status])
}

/// A correction of the session's cash box — never a silent edit of a transaction
model SessionAdjustment {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String
  amount      Decimal  @db.Decimal(18, 2) // signed: + adds cash to the box, - removes it
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User        @relation("SessionAdjustmentBy", fields: [createdById], references: [id])

  @@index([sessionId])
}

model WorkSessionAudit {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  action    String // session.created | session.updated | harvest.created | harvest.approved | ...
  userId    String
  oldValue  Json?
  newValue  Json?
  reason    String?
  createdAt DateTime @default(now())

  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation("SessionAuditBy", fields: [userId], references: [id])

  @@index([sessionId, createdAt])
}

model Supplier {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@index([tenantId])
}

model Purchase {
  id              String   @id @default(cuid())
  tenantId        String
  purchaseNumber  Int
  supplierId      String
  branchId        String
  total           Decimal  @db.Decimal(18, 2)
  paidAmount      Decimal  @default(0) @db.Decimal(18, 2)
  invoiceImageUrl String?
  notes           String?
  receivedAt      DateTime @default(now()) // the day the goods arrived (may be earlier than when it was recorded)
  createdById     String
  createdAt       DateTime @default(now())

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId, createdAt])
}

model PurchaseItem {
  id          String  @id @default(cuid())
  purchaseId  String
  productId   String
  productName String // snapshot
  quantity    Int
  unitCost    Decimal @db.Decimal(18, 2)
  total       Decimal @db.Decimal(18, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Debt {
  id             String        @id @default(cuid())
  tenantId       String
  direction      DebtDirection
  status         DebtStatus    @default(OPEN)
  kind           DebtKind      @default(DEFICIT)
  partyName      String // snapshot of the counterparty's name
  supplierId     String?
  employeeId     String?
  amount         Decimal       @db.Decimal(18, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(18, 2)
  currency       Currency      @default(USDT)
  dueDate        DateTime?
  referenceType  String?
  referenceId    String?
  notes          String?
  receiptUrl     String? // receipt / contract photo or PDF for the loan or deficit itself
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastReminderAt DateTime? // last time a DEBT_DUE reminder was sent for this debt

  createdBy User          @relation("DebtCreatedBy", fields: [createdById], references: [id])
  payments  DebtPayment[]

  @@index([tenantId, direction, status])
  @@index([status, dueDate])
}

model DebtPayment {
  id             String   @id @default(cuid())
  tenantId       String
  debtId         String
  amount         Decimal  @db.Decimal(18, 2)
  currency       Currency @default(USDT)
  registerId     String?
  note           String?
  proofImageUrl  String? // cheque / payment-proof image or PDF — mainly used for supplier payments
  performedById  String
  createdAt      DateTime @default(now())

  debt        Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  performedBy User @relation("DebtPaymentPerformedBy", fields: [performedById], references: [id])

  @@index([tenantId, createdAt])
}

/** Returning a defective/expired/problem product back to a supplier — decreases stock and records a credit owed by the supplier */
model PurchaseReturn {
  id          String   @id @default(cuid())
  tenantId    String
  supplierId  String
  purchaseId  String? // optional link to the originating purchase, if known
  productId   String
  productName String // snapshot
  warehouseId String // stock is removed from here
  quantity    Int
  unitCost    Decimal  @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  note        String? // reason — expired, defective, etc.
  createdById String
  createdAt   DateTime @default(now())

  supplier  Supplier  @relation(fields: [supplierId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User      @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, createdAt])
  @@index([supplierId])
}

// ─────────────── Phase 4 — Activity Log / Notifications ───────────────

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  method     String
  path       String
  action     String // e.g. "sales.create"
  entityId   String?
  statusCode Int
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  type      String // LOW_STOCK | PRODUCT_EXPIRING | DEBT_DUE | SYSTEM | SUBSCRIPTION_EXPIRING
  title     String
  body      String?
  refType   String?
  refId     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // ─── Phase 5 — message queue (BullMQ) for out-of-app channels ───
  channel        NotificationChannel @default(IN_APP)
  dispatchStatus DispatchStatus      @default(SENT) // IN_APP is SENT immediately; SMS/WHATSAPP start as PENDING and are updated by the worker
  dispatchedAt   DateTime?
  attempts       Int                 @default(0)
  lastError      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@index([dispatchStatus])
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────── Phase 4 — Backups ───────────────

enum BackupType {
  MANUAL
  AUTO
}

enum BackupStatus {
  COMPLETED
  FAILED
}

model Backup {
  id          String       @id @default(cuid())
  tenantId    String
  type        BackupType   @default(MANUAL)
  status      BackupStatus @default(COMPLETED)
  fileName    String
  sizeBytes   Int          @default(0)
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([tenantId, createdAt])
}

// ──────────────────── Phase 8 — online payment gateway (Mock/Pluggable) ────────────────────

enum GatewayPurpose {
  SUBSCRIPTION
}

enum GatewayIntentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/**
 * Online payment intent — abstract and independent of the subscription (free-form referenceId/meta)
 * so it can later be replaced with a real gateway (webhook) without changing consumers.
 */
model GatewayIntent {
  id            String              @id @default(cuid())
  tenantId      String
  purpose       GatewayPurpose
  referenceId   String? // e.g. the subscription id
  provider      String? // VISA_CARD | OTHER_ONLINE | AUTOMATIC ...
  amount        Decimal             @db.Decimal(18, 2)
  currency      Currency            @default(USDT)
  status        GatewayIntentStatus @default(PENDING)
  providerRef   String?
  meta          Json?
  createdById   String?
  createdAt     DateTime            @default(now())
  confirmedAt   DateTime?

  @@index([tenantId, status])
  @@index([referenceId])
}

// ──────────────────── Phase 9 — billing cycle and subscription history ────────────────────

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionHistoryEvent {
  PLAN_CHANGED
  RENEWED
  EXPIRED_DOWNGRADE
  PLAN_STOPPED
  PLAN_RESUMED
}

/** Read-only — plan codes are snapshotted (not a relation), same pattern as Debt.partyName */
model SubscriptionHistory {
  id           String                   @id @default(cuid())
  tenantId     String
  event        SubscriptionHistoryEvent
  fromPlanCode PlanCode?
  toPlanCode   PlanCode
  billingCycle BillingCycle?
  startsAt     DateTime
  endsAt       DateTime?
  createdAt    DateTime                 @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ──────────────────── Phase 9b — Platform Feedback ────────────────────

enum PlatformFeedbackType {
  SUGGESTION
  COMPLAINT
  BUG
  FEATURE_REQUEST
}

enum PlatformFeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

/** Store owners' feedback/complaints about the platform — reviewed and handled only by the platform admin */
model PlatformFeedback {
  id                String                 @id @default(cuid())
  tenantId          String
  submittedByUserId String
  type              PlatformFeedbackType
  subject           String
  body              String
  status            PlatformFeedbackStatus @default(NEW)
  adminNote         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy User   @relation(fields: [submittedByUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

// ──────────────────── Phase 11 — Partners' profit & loss ────────────────────

enum PartnerEntryType {
  PROFIT
  LOSS
  WITHDRAWAL
  ADJUSTMENT
}

model Partner {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  phone        String?
  /** Ownership/profit-share percentage (0–100) — used to auto-calculate this partner's share of a distribution */
  sharePercent Decimal?  @db.Decimal(5, 2)
  notes        String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries      PartnerLedgerEntry[]
  workSessions WorkSession[]

  @@index([tenantId])
  cashPaid     CashTransaction[] @relation("CashTxPaidByPartner")
  cashReceived CashTransaction[] @relation("CashTxReceivedByPartner")
}

model PartnerLedgerEntry {
  id            String           @id @default(cuid())
  tenantId      String
  partnerId     String
  type          PartnerEntryType
  amount        Decimal          @db.Decimal(18, 2) // PROFIT/LOSS/WITHDRAWAL are always positive; ADJUSTMENT may be signed
  /** e.g. "2026-09" — the period this profit/loss distribution covers */
  period        String?
  /** How this amount was calculated, e.g. "30% of net profit (2026-09): 10,000" — shown alongside the entry for transparency */
  method        String?
  note          String?
  receiptUrl    String? // optional pay slip / receipt photo (mainly used for WITHDRAWAL)
  performedById String
  createdAt     DateTime         @default(now())

  partner     Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  performedBy User    @relation("PartnerLedgerEntryPerformedBy", fields: [performedById], references: [id])

  @@index([tenantId, createdAt])
  @@index([partnerId])
}

// ─────────────────────── License keys (platform-level, not store data) ───────────────────────

enum LicenseKeyStatus {
  ACTIVE
  USED
  REVOKED
}

/** One-time activation key a super admin generates for a new store to register with */
model LicenseKey {
  id             String           @id @default(cuid())
  key            String           @unique
  status         LicenseKeyStatus @default(ACTIVE)
  note           String?
  createdById    String
  usedByTenantId String?
  usedAt         DateTime?
  createdAt      DateTime         @default(now())
  /** Plan the redeeming tenant is provisioned with. Null = default FREE (legacy keys). */
  planId         String?
  /** Key can no longer be redeemed after this time, even if still ACTIVE. Null = never expires. */
  expiresAt      DateTime?

  createdBy    User    @relation("LicenseKeyCreatedBy", fields: [createdById], references: [id])
  usedByTenant Tenant? @relation(fields: [usedByTenantId], references: [id])
  plan         Plan?   @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([usedByTenantId])
}
